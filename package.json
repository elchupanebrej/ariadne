{
  "name": "ariadne-reasoning",
  "version": "0.2.0",
  "description": "Software reasoning layer and epistemic substrate for autonomous agents and engineers",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "ariadne": "dist/cli/index.js"
  },
  "files": [
    "dist",
    ".agents/skills/ariadne",
    ".agents/skills/codebase-design",
    ".agents/skills/grilling",
    ".agents/skills/domain-modeling",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elchupanebrej/ariadne.git"
  },
  "homepage": "https://github.com/elchupanebrej/ariadne#readme",
  "bugs": {
    "url": "https://github.com/elchupanebrej/ariadne/issues"
  },
  "keywords": [
    "ai",
    "reasoning",
    "epistemics",
    "agents",
    "agent-skills",
    "software-engineering",
    "decision-trees"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run --testTimeout 15000",
    "verify": "npm run typecheck && npm test",
    "docs:build": "node scripts/build-nine-operations-html.mjs",
    "docs:check": "node scripts/build-nine-operations-html.mjs --check",
    "docs:test": "npm run docs:check && node scripts/test-nine-operations-html.mjs",
    "skills:link": "bash scripts/link-skill.sh",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "prepack": "npm run build",
    "benchmark": "tsx scripts/run-benchmark.mjs",
    "benchmark:corpus": "tsx scripts/run-benchmark-corpus.mjs",
    "benchmark:local": "tsx scripts/run-local-preflight.mjs"
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "marked": "18.0.11",
    "playwright": "1.61.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "4.1.6"
  }
}
